generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// WatchPay users — registration data saved after OTP verification.
// MongoDB (Atlas): ids are ObjectIds mapped to String, collection = "User".
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  username      String    @unique
  mobile        String    @unique // 10-digit Indian mobile number
  password      String    // scrypt hash in "salt:hash" format (never plain text)
  walletBalance Float     @default(0) // real balance shown in home header wallet (starts at 0)
  status        String    @default("active") // "active" | "banned" (admin master control)
  lastLoginAt   DateTime? // security centre — last successful user login
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders       Order[]
  withdrawals  Withdrawal[]
  transactions Transaction[]
  deposits     Deposit[]
}

// Payment orders — persisted when the user taps PAY on a live order.
// Live-feed orders are ephemeral (generated); these are REAL payment intents.
// merchantOrderId links the Order to its gateway Deposit (same ₹ amount).
model Order {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  amount          Float
  bonus           Float    @default(0)
  platform        String // branch_name — 1Win / Stake / …
  merchantOrderId String   @default("") // Deposit.merchantOrderId — set once the gateway link is created
  status          String   @default("processing") // processing | completed | expired
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([merchantOrderId])
}

// Withdrawal requests — created by the user, processed by the admin.
// Balance is DEDUCTED immediately on request (hold) and refunded on reject.
model Withdrawal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  amount      Float
  method      String // "upi" | "bank"
  destination String // UPI id or "account • IFSC"
  status      String   @default("pending") // pending | paid | rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Global app configuration — ONE document (key = "global"), edited live
// from the Admin Master Control panel (bonus %, maintenance, announcement…).
model AppSetting {
  id                String   @id @default("global") @map("_id")
  bonusPercent      Float    @default(12.5)
  orderMin          Float    @default(700)
  orderMax          Float    @default(9000)
  maintenance       Boolean  @default(false)
  announcement      String   @default("")
  // security centre — payout guard rails (enforced by /api/withdrawals)
  withdrawMin       Float    @default(200)
  withdrawMax       Float    @default(50000)
  dailyPayoutLimit  Float    @default(100000)
  // master control — comma-separated platform names turned OFF by admin
  disabledPlatforms String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Money ledger — EVERY rupee movement (admin credit/debit, withdrawal
// hold/paid/refund, order bonus) is recorded here. Admin "Ledger" tab.
model Transaction {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String?  @db.ObjectId
  user         User?    @relation(fields: [userId], references: [id])
  type         String // credit | debit | order_bonus | withdrawal_hold | withdrawal_paid | withdrawal_refund
  amount       Float
  balanceAfter Float    @default(0) // wallet balance right after this movement
  note         String   @default("")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([userId])
}

// Payment gateways (QwackPay & co.) — ADMIN-managed. The SAME merchant can be
// added MULTIPLE times with different API keys (key rotation / load split).
// Every active gateway participates in weighted routing for user deposits.
model PaymentGateway {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  label       String // display name, e.g. "QwackPay #1"
  provider    String   @default("qwackpay")
  merchantId  String // merchant number, e.g. 681551699 — NOT unique (multi-key!)
  apiKey      String // docking key from the merchant backend (secret)
  apiUrl      String   @default("https://qwackpay.com/api/v1")
  payinRate   Float    @default(7.0) // collection rate %
  payoutRate  Float    @default(3.0) // payment rate %
  payoutFlat  Float    @default(6) // payment flat fee ₹
  minAmount   Float    @default(100)
  maxAmount   Float    @default(100000)
  weight      Int      @default(1) // routing weight (1..10) — higher = more traffic
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deposits Deposit[]

  @@index([active])
}

// Deposit (money-in) orders through a payment gateway.
// Balance is credited ONLY on a signature-verified success callback/query.
model Deposit {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  gatewayId       String?  @db.ObjectId
  gateway         PaymentGateway? @relation(fields: [gatewayId], references: [id])
  merchantOrderId String   @unique
  qwackOrderId    String   @default("")
  amount          Float
  fee             Float    @default(0)
  utr             String   @default("")
  status          String   @default("pending") // pending | success | failed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([gatewayId])
}

// Admin audit trail — every master-control action lands here.
model AdminLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String // e.g. "user.ban", "withdrawal.paid", "settings.update"
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
